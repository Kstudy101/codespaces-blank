# ===================================================================
# server/.env.example — server/.env に写して埋める
#
# このファイルは値を入れずにコミットする。server/.env の方は
# .gitignore で除外してある。
#
# 本番（ChemiCloud）は cPanel → Setup Node.js App →
# Environment variables に同じ名前で入れる。.env を置く必要は無い
# ── 置いた場合も、既にある環境変数の方が勝つ（lib/env.mjs）。
# ===================================================================

# ---- MySQL（cPanel → MySQL® Databases で作る）----------------------
# ユーザー名とDB名には cPanel アカウント名が接頭辞として付く。
# 作成画面に出た名前をそのまま写すこと。
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_kstudy
DB_PASSWORD=
DB_NAME=cpaneluser_kstudy101

# 共用サーバーの MySQL は同時接続の上限が低い。
# 配信バッチと webhook が同時に走る前提で、上限より十分低く取る。
DB_POOL_SIZE=5


# ---- 以下は P2 以降で使う。今は空のままでよい ----------------------

# LINE Messaging API（LINE Developers → Messaging API チャネル）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LINE Login（別チャネル。Messaging API のものとは違う）
#
# ★ Login と Messaging API のチャネルは、LINE Developers の
#   「同じプロバイダー」に置くこと。別プロバイダーだと userId が
#   別物になり、登録は成功するのに配信だけが永久に届かない。
#   エラーはどこにも出ないので、配信が始まる朝まで気づけない。
#
# redirect_uri は認証画面へ渡すものと 1 文字でも違うと invalid_grant。
# LINE Developers のコンソールに登録する値と完全に一致させること。
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=https://example.chemicloud.com/line/callback

# 友だち追加のリンク（連携完了ページのボタン）
LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@kstudy101

# 占いページのオリジン。ここからの fetch だけを許可する（CORS）。
# サイトは Xserver、この API は ChemiCloud なので別オリジンになる。
ALLOWED_ORIGINS=https://www.kstudy101.jp,https://kstudy101.jp

# Stripe（本番の鍵は sk_live_ で始まる。取り違えると本番で課金される）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 配信の停止スイッチ。1 にすると送信だけ止めてログは残す。
# 原稿の入れ替えや障害対応で、cron を触らずに止められるようにする。
PUSH_DISABLED=0
