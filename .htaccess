# LINEで学ぶ 1日1分 簡単韓国語 — Xserver（Apache）用設定
#
# このサイトは SPA ではなく、独立した HTML が並ぶ静的サイト。
# したがって「全部 index.html に流す」SPA フォールバックは入れない。
# それを入れると存在しないURLまで 200 を返し、404 が機能しなくなる。
#
# 本当に必要なのは逆で、拡張子なしURL（/privacy）を privacy.html に
# 内部で結びつけること。Cloudflare Pages はこれを自動でやっていたが
# Apache は何もしないため、移行するとサイト内リンクがすべて 404 になる。

AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On

# ------------------------------------------------------------------
# 1) HTTPS へ寄せる
#    Xserver は SSL 終端がフロントにあるため HTTPS 変数が立たない構成が
#    ありうる。X-Forwarded-Proto も見て二重リダイレクトを防ぐ。
# ------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------------
# 2) www ありに寄せる（canonical と揃える）
#
#    このサーバーは kstudy101.jp → www.kstudy101.jp の 301 を
#    すでに返している（サーバーパネルの「www有無の統一」設定）。
#    ここで逆向き（www を外す）を書くと
#      apex →(サーバー)→ www →(この設定)→ apex → …
#    と無限ループになりサイトが落ちる。サーバーの向きに合わせること。
#
#    apex を正としたい場合は、先にサーバーパネルの統一設定を解除し、
#    そのうえでこの規則を逆向きにして
#    tools/set-site-url.py で canonical も入れ替える。
# ------------------------------------------------------------------
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} !^$
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------------
# 3) 重複URLを1つに寄せる
#    /index.html と / 、/privacy.html と /privacy が両方 200 を返すと
#    同じ内容が2つのURLに存在することになる。canonical は正しく出るが、
#    クロール上の無駄なので 301 でまとめる。
#    ※ THE_REQUEST を見ているので、下の内部書き換え（4）とは衝突しない。
# ------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ------------------------------------------------------------------
# 4) 拡張子なしURL → .html（内部書き換え。URLは変わらない）
#    /privacy → privacy.html
#    実ファイル・実ディレクトリが優先されるので、
#    /kanji.json や /ogp.png はそのまま配信される。
# ------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ------------------------------------------------------------------
# 廃止したページ（2026-08-16 の事業転換）
#
#   404 ではなく 410。404 は「今は無い」なのでクローラーがしばらく
#   取りに来続けるが、410 は「意図して廃止した」なので再試行が止まり、
#   索引からも早く落ちる。
#
#   /（トップ）への 301 にはしない ── 「占いページ → 学習トップ」という
#   動線が残ってしまい、クローラーにも「同じものを移した」と読まれる。
#
#   実体はもう無いので、上の 4) は素通りする（.html が無いと書き換えない）。
#   ここが無ければ 404 になるだけで、壊れはしない。
#   戻すときは PUBLIC・sitemap.xml・deploy.yml のスモークも一緒に
#   （docs/plan-fortune-removal.md）。
# ------------------------------------------------------------------
RedirectMatch gone ^/(omikuji|gilbang|amulet|words)$

# ------------------------------------------------------------------
# 404
# ------------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------------
# MIME / 文字コード
# ------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/svg+xml .svg
  AddCharset UTF-8 .html .css .js .json .xml .txt
</IfModule>

# ------------------------------------------------------------------
# 圧縮
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/json application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------
# キャッシュ
#   HTML は毎回確認させる（内容を差し替えたらすぐ反映したいため）。
#   kanji.json は差し替え頻度が低いので1日。
#
#   .js も HTML と同じ扱いにする。2026-08-16 の事業転換で共用スクリプト
#   （saju/fortune/study/omikuji/gilbang/amulet）は全部消えたので、
#   いま .js は 1 つも配信していない ── 規則は残す。次に足した 1 本目が
#   既定の 1 週間キャッシュを掴む、が起きないようにするため。
#
#   ファイル名に版が入っていないので、既定の 1 週間のままだと
#   「HTML は毎回取り直すのに JS は最大 1 週間古いまま」という組み合わせが
#   起きる。新しい HTML が古い JS を呼ぶ形になり、直したはずの不具合が
#   一部の利用者にだけ残る ── しかも本人にしか再現しない。
#
#   no-cache は「保存するな」ではなく「使う前に確認しろ」なので、
#   中身が変わっていなければ 304 が返るだけ。ファイルは 7〜19KB で
#   トップでも 4 本なので、往復の増加は無視できる。
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 week"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType text/css              "access plus 1 week"
  ExpiresByType application/json      "access plus 1 day"
  ExpiresByType image/png             "access plus 1 month"
  ExpiresByType image/svg+xml         "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  # 拡張子で見る。.js の MIME 型は環境によって text/javascript にも
  # application/javascript にもなるので、ExpiresByType では取りこぼす。
  #
  # .css も同じ扱いにする。ファイル名に版が無いので、
  # 新しい HTML と古い CSS が組み合わさると、追加したばかりの部分が
  # 素のまま出るか、まったく見えなくなる。JS だけ直して CSS を
  # 1週間キャッシュのままにしていたため、実際にそれが起きた。
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------
# セキュリティヘッダ
#   広告（AdSense）は当サイト内に iframe を挿す側なので、
#   SAMEORIGIN を入れても配信には影響しない。
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------------
# 公開しないもの
#   デプロイ側でも除外しているが、取りこぼした場合の保険。
# ------------------------------------------------------------------
<FilesMatch "\.(db|sqlite3?|py|sh|md|yml|yaml)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^(data|tools|\.github)/ - [F,L]
</IfModule>
